#!/usr/bin/env bash

SELECTION="$(printf " Lock\n󰤄 Suspend\n Reboot\n󰐥 Poweroff" | bash ~/.local/bin/fuzzel_helper.sh --dmenu -l 4 -p "Power Menu: ")"

case $SELECTION in
	*"Lock")
		hyprlock;;
	*"Suspend")
		systemctl suspend;;
	*"Reboot")
		systemctl reboot;;
	*"Poweroff")
		systemctl poweroff;;
esac
