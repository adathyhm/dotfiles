{
  "layer": "top",
  "position": "left",

  "margin-top": 6,
  "margin-left": 6,
  "margin-bottom": 6,
  "margin-right": 0,
  // "padding": 5,
  "spacing": 10,

  "modules-left": [
    "clock#date",
  ],

  "modules-center": [
    "niri/workspaces",
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "pulseaudio#microphone",
    "battery",
    "clock#time",
    "custom/power"
  ],

  "battery": {
    "interval": 2,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "",
    "tooltip-format": "{capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰲜",
    "tooltip-format": " {bandwidthUpBits}  {bandwidthDownBits}\n{ifname}\n{ipaddr}/{cidr}\n",
    "tooltip-format-wifi": " {essid} {frequency}MHz\nStrength: {signaldBm}dBm ({signalStrength}%)\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}",
    "interval": 10,
    "on-click": "foot -e wifitui",
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/powermenu"
  },

  "clock#date": {
    "format": "{:%d%n%m%n%y%n}",
    "tooltip-format": false,
  },

  "clock#time": {
    "format": "{:%H\n%M}",
    "tooltip": false
  },

  "niri/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "sort-by-number": true,
    "active-only": false,
    "on-click": "activate",
  },

  "niri/window": {
    "max-length": 100,
    "separate-outputs": true
  },

  "pulseaudio": {
    "on-click-right": "foot -e wiremix",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format": "<span foreground='#fab387'>{icon}</span>",
    "format-muted": "<span foreground='#7c6f64'></span>",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span foreground='#a9b665'></span>",
    "format-source-muted": "<span foreground='#7c6f64'>󰍭</span>", 

    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "foot -e wiremix",

    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  }
}
